{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "cogneiss/starter",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.5.0",
        "inertiajs/inertia-laravel": "v3.0.6",
        "laravel/ai": "^0.11.0",
        "laravel/fortify": "^1.38.0",
        "laravel/framework": "^13.26.1",
        "laravel/pennant": "^1.26",
        "laravel/socialite": "^5.30",
        "laravel/wayfinder": "^0.1.21",
        "nunomaduro/essentials": "^1.2.0",
        "spatie/laravel-data": "^4.23",
        "spatie/laravel-permission": "^8.3",
        "spatie/laravel-typescript-transformer": "^3.3"
    },
    "require-dev": {
        "cyclonedx/cyclonedx-php-composer": "^6.2",
        "driftingly/rector-laravel": "^2.5.0",
        "fakerphp/faker": "^1.24.1",
        "icanhazstring/composer-unused": "^0.9.6",
        "laramint/laravel-brain": "^2.4",
        "larastan/larastan": "^3.10.0",
        "laravel/boost": "^2.5.5",
        "laravel/pail": "^1.2.7",
        "laravel/pao": "^1.1.4",
        "laravel/pint": "^1.30.5",
        "laravel/tinker": "^3.0.2",
        "mockery/mockery": "^1.6.15",
        "nunomaduro/collision": "^8.9.5",
        "pestphp/pest": "^5.1.1",
        "pestphp/pest-plugin-browser": "^5.0.1",
        "pestphp/pest-plugin-laravel": "^5.0.1",
        "pestphp/pest-plugin-type-coverage": "^5.0.2",
        "rector/rector": "^2.6.3",
        "roave/security-advisories": "dev-latest",
        "shipmonk/dead-code-detector": "^1.3.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "@php artisan ai:install --no-interaction",
            "@php artisan db:seed --class=RoleTemplateSeeder --force",
            "bun install",
            "bun run build",
            "@php -r \"echo PHP_EOL, 'Setup done. If anything misbehaves, run: php artisan app:doctor', PHP_EOL;\""
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "bunx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"bun run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@hooks:install"
        ],
        "hooks:install": [
            "@php -r \"if (is_dir('.git')) { exec('git config core.hooksPath .githooks'); }\""
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan clear",
            "@update:requirements",
            "@php artisan boost:install --guidelines --skills --no-interaction",
            "@php -r \"copy('AGENTS.md', 'GEMINI.md');\""
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "update:requirements": [
            "composer bump",
            "bunx npm-check-updates -u"
        ],
        "lint": [
            "rector",
            "pint --parallel",
            "@typescript:generate",
            "bun run lint"
        ],
        "typescript:generate": "@php artisan typescript:transform",
        "test:type-coverage": "pest --type-coverage --min=100 --memory-limit=2G",
        "test:lint": [
            "pint --parallel --test",
            "rector --dry-run",
            "bun run test:lint"
        ],
        "test:unit": "XDEBUG_MODE=\"coverage\" pest --parallel --coverage --exactly=100.0",
        "test:audit": [
            "@composer audit --no-interaction",
            "bun audit --prod"
        ],
        "test:dead-code": "phpstan analyse -c phpstan-deadcode.neon --memory-limit=2G",
        "test:deps": "composer-unused --no-progress",
        "test:knip": "bun run knip",
        "test:wiki": "@php artisan wiki:lint",
        "test:fast": "bin/pest-with-failure-summary.sh --parallel --compact --bail",
        "test:tia-seed": "XDEBUG_MODE=\"coverage\" pest --tia --fresh -d memory_limit=2G",
        "sbom": "@composer CycloneDX:make-sbom --output-format=JSON --output-file=sbom.json",
        "test:sqlite": "DB_CONNECTION=sqlite DB_DATABASE=:memory: pest --compact --exclude-group=pgvector -d memory_limit=2G",
        "test:mutate": "pest --mutate --min=80 --covered-only --path=app --compact -d memory_limit=2G",
        "test:a11y": "pest tests/Browser/AccessibilityTest.php --compact",
        "test:dirty": "pest --parallel --compact --dirty",
        "test:types": [
            "bunx concurrently --kill-others-on-fail -n phpstan,tsc \"vendor/bin/phpstan --memory-limit=2G\" \"bun run test:types\""
        ],
        "test": [
            "@test:lint",
            "@test:type-coverage",
            "@test:types",
            "@test:unit"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "cyclonedx/cyclonedx-php-composer": true,
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
