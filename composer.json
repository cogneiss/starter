{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "cogneiss/starter",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.5.0",
        "inertiajs/inertia-laravel": "^3.5.2",
        "laravel/ai": "^1.3",
        "laravel/fortify": "^1.41.0",
        "laravel/framework": "^13.39.0",
        "laravel/pennant": "^1.26",
        "laravel/reverb": "^1.12.0",
        "laravel/sanctum": "^4.3.3",
        "laravel/socialite": "^5.31",
        "laravel/wayfinder": "^0.1.23",
        "nunomaduro/essentials": "^1.2.0",
        "spatie/laravel-activitylog": "^5.1.3",
        "spatie/laravel-data": "^4.23.1",
        "spatie/laravel-permission": "^8.3.2",
        "spatie/laravel-typescript-transformer": "^3.3"
    },
    "require-dev": {
        "cyclonedx/cyclonedx-php-composer": "^6.2",
        "driftingly/rector-laravel": "^2.7.3",
        "fakerphp/faker": "^1.24.1",
        "heyosseus/sloppy": "^1.8",
        "icanhazstring/composer-unused": "^0.9.7",
        "laramint/laravel-brain": "^2.7.1",
        "larastan/larastan": "^3.13.2",
        "laravel/boost": "^2.10.3",
        "laravel/pail": "^1.2.7",
        "laravel/pao": "^1.1.5",
        "laravel/pint": "^1.32.1",
        "laravel/tinker": "^3.0.2",
        "laravel/vet": "^0.2.1",
        "mockery/mockery": "^1.6.15",
        "nunomaduro/collision": "^8.9.5",
        "pestphp/pest": "^5.3.4",
        "pestphp/pest-plugin-browser": "^5.1.2",
        "pestphp/pest-plugin-laravel": "^5.0.1",
        "pestphp/pest-plugin-type-coverage": "^5.0.3",
        "phpstan/phpstan-deprecation-rules": "^2.0.5",
        "phpstan/phpstan-strict-rules": "^2.1",
        "rector/rector": "^2.8.2",
        "roave/security-advisories": "dev-latest",
        "sentry/sentry-laravel": "^4.29",
        "shipmonk/dead-code-detector": "^1.4.2",
        "shipmonk/phpstan-rules": "^4.4.1",
        "tomasvotruba/cognitive-complexity": "^1.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "@php artisan ai:install --no-interaction",
            "@php artisan db:seed --class=RoleTemplateSeeder --force",
            "bun install",
            "bun add --global intelephense typescript-language-server",
            "bunx playwright install chromium",
            "bun run build",
            "@php -r \"echo PHP_EOL, 'Setup done. If anything misbehaves, run: php artisan app:doctor', PHP_EOL;\""
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@hooks:install"
        ],
        "hooks:install": [
            "@php -r \"if (is_dir('.git')) { exec('git config core.hooksPath .githooks'); }\""
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan clear",
            "@update:requirements",
            "@php artisan boost:install --guidelines --skills --no-interaction",
            "@php -r \"copy('AGENTS.md', 'GEMINI.md');\""
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"echo PHP_EOL, 'Next: point DB_* in .env at a Postgres database, then run: composer setup', PHP_EOL;\""
        ],
        "update:requirements": [
            "composer bump",
            "bunx npm-check-updates -u"
        ],
        "lint": [
            "rector",
            "pint --parallel",
            "@typescript:generate",
            "bun run lint"
        ],
        "typescript:generate": "@php artisan typescript:transform",
        "test:type-coverage": "pest --type-coverage --min=100 --memory-limit=2G",
        "test:lint": [
            "pint --parallel --test",
            "rector --dry-run",
            "bun run test:lint"
        ],
        "test:unit": "XDEBUG_MODE=\"coverage\" pest --parallel --no-tia --coverage --exactly=100.0",
        "test:evals": "pest --testsuite=Evals --group=Evals --compact",
        "screenshots": "pest tests/Browser/ReadmeScreenshotsTest.php --group=screenshots --compact",
        "test:audit": [
            "@composer audit --no-interaction",
            "bun audit --prod"
        ],
        "test:strict": "phpstan analyse -c phpstan-strict.neon --memory-limit=2G",
        "test:dead-code": "phpstan analyse -c phpstan-deadcode.neon --memory-limit=2G",
        "test:deps": "composer-unused --no-progress",
        "test:knip": "bun run knip",
        "test:wiki": "@php artisan wiki:lint",
        "test:fast": "bin/pest-with-failure-summary.sh --parallel --compact --bail",
        "test:tia-seed": "XDEBUG_MODE=\"coverage\" pest --tia --fresh -d memory_limit=2G",
        "sbom": "@composer CycloneDX:make-sbom --output-format=JSON --output-file=sbom.json",
        "test:sqlite": "DB_CONNECTION=sqlite DB_DATABASE=:memory: pest --compact --exclude-group=pgvector -d memory_limit=2G",
        "test:mutate": "pest --mutate --min=80 --covered-only --path=app --compact -d memory_limit=2G",
        "test:a11y": "pest tests/Browser/AccessibilityTest.php --compact",
        "test:dirty": "pest --parallel --compact --dirty",
        "test:types": [
            "bunx concurrently --kill-others-on-fail -n phpstan,tsc \"vendor/bin/phpstan --memory-limit=2G\" \"bun run test:types\""
        ],
        "test": [
            "@test:lint",
            "@test:types",
            "@test:strict",
            "@test:type-coverage",
            "@test:unit"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "cyclonedx/cyclonedx-php-composer": true,
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "laravel/vet": true
        },
        "audit": {
            "ignore-abandoned": [
                "symplify/rule-doc-generator-contracts"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
