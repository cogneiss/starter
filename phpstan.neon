includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - phar://phpstan.phar/conf/bleedingEdge.neon

parameters:

    paths:
        - app
        - bootstrap/app.php
        - config
        - database
        - public
        - routes
        # Test fixtures are plain classes, so they analyse cleanly and keep the
        # traits they exercise (app/Ai/Concerns) inside PHPStan's view. Pest
        # test files themselves are not analysable at this level.
        - tests/Fixtures


    level: max

    tmpDir: /tmp/phpstan

    ignoreErrors:
