includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - phar://phpstan.phar/conf/bleedingEdge.neon

parameters:

    paths:
        - app
        - bootstrap/app.php
        - config
        - database
        - public
        - routes


    level: max

    tmpDir: /tmp/phpstan

    ignoreErrors:
        # The trait is exercised from tests until the first organization-scoped
        # model lands in app/. Drop this entry then.
        -
            identifier: trait.unused
            path: app/Concerns/BelongsToOrganization.php
