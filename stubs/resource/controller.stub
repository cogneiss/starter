<?php

declare(strict_types=1);

namespace {{ namespace }}\Http\Controllers;

use App\Actions\Create{{ class }};
use App\Http\Requests\Create{{ class }}Request;
use App\Models\{{ class }};
use Illuminate\Http\RedirectResponse;
use Illuminate\Support\Facades\Gate;
use Inertia\Inertia;
use Inertia\Response;

final readonly class {{ class }}Controller
{
    public function create(): Response
    {
        Gate::authorize('create', {{ class }}::class);

        return Inertia::render('{{ kebab }}/create');
    }

    public function store(Create{{ class }}Request $request, Create{{ class }} $action): RedirectResponse
    {
        Gate::authorize('create', {{ class }}::class);

        $action->handle($request->validated());

        Inertia::flash('toast', [
            'type' => 'success',
            'message' => __('{{ title }} created.'),
        ]);

        return to_route('dashboard');
    }
}
