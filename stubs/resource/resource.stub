<?php

declare(strict_types=1);

namespace {{ namespace }}\Resources\Definitions;

use App\Data\{{ class }}Data;
use App\Models\{{ class }};
use App\Policies\{{ class }}Policy;
use App\Resources\ResourceContract;
use App\Support\FilterType;
use App\Support\ResourceFilter;
use Illuminate\Database\Eloquent\Builder;
use Illuminate\Database\Eloquent\Model;

final class {{ class }}Resource implements ResourceContract
{
    public function key(): string
    {
        return '{{ key }}';
    }

    public function label(): string
    {
        return '{{ label }}';
    }

    public function model(): string
    {
        return {{ class }}::class;
    }

    public function dataClass(): string
    {
        return {{ class }}Data::class;
    }

    public function policy(): string
    {
        return {{ class }}Policy::class;
    }

    /**
     * Only the creation screen is generated, so that is where a record points
     * until you add a show or edit route of your own.
     */
    public function url(Model $record): string
    {
        return route('{{ kebab }}.create');
    }

    /**
     * Columns search matches against. A dotted entry ('user.name') matches
     * through a belongsTo relation. Every entry must be a real column.
     *
     * @return list<string>
     */
    public function searchable(): array
    {
        return ['name'];
    }

    /**
     * Columns a list may be ordered by, most useful first — the first entry is
     * the default order. An allowlist, so no request can order by a column the
     * screen never shows.
     *
     * @return list<string>
     */
    public function sortable(): array
    {
        return ['created_at', 'name'];
    }

    /**
     * The filters a list of this resource offers. Each one names a column and a
     * type; the type decides how it is read from the URL and how it narrows the
     * query, so a page never invents a filter of its own.
     *
     * @return list<ResourceFilter>
     */
    public function filters(): array
    {
        return [
            // new ResourceFilter(
            //     key: 'status',
            //     label: __('Status'),
            //     type: FilterType::Select,
            //     column: 'status',
            //     options: ['draft', 'published'],
            // ),
        ];
    }

    public function recordLabel(Model $record): string
    {
        assert($record instanceof {{ class }});

        return $record->name;
    }

    public function recordDescription(Model $record): ?string
    {
        assert($record instanceof {{ class }});

        return null;
    }

    /**
     * Narrow this to the acting organization with a where clause. Filtering
     * records out after fetching them is not scoping.
     *
     * @return Builder<{{ class }}>
     */
    public function scopedQuery(): Builder
    {
        return {{ class }}::query();
    }
}
