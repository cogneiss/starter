        assert($record instanceof {{ class }});

        return $record->name;
    }

    public function recordDescription(Model $record): ?string
    {
        assert($record instanceof {{ class }});

        return null;
    }

    /**
     * Narrow this to the acting organization with a where clause. Filtering
