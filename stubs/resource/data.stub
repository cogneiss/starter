<?php

declare(strict_types=1);

namespace {{ namespace }}\Data;

use App\Models\{{ class }};
use Spatie\LaravelData\Data;
use Spatie\TypeScriptTransformer\Attributes\TypeScript;

#[TypeScript('{{ class }}')]
final class {{ class }}Data extends Data
{
    public function __construct(
        public string $id,
        public string $name,
    ) {}

    public static function fromModel({{ class }} ${{ variable }}): self
    {
        return new self(
            id: ${{ variable }}->id,
            name: ${{ variable }}->name,
        );
    }
}
