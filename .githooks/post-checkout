#!/bin/sh

# On a branch switch, install whatever the lock files now ask for.
if [ "$3" = 1 ]; then
    "$(dirname "$0")/sync-deps" "$1" "$2"
fi

# A brand-new linked worktree (old head is the null sha) gets its own .env,
# databases and build, so it never shares state with the main checkout.
if [ "$1" = 0000000000000000000000000000000000000000 ] && [ "$(git rev-parse --git-dir)" != "$(git rev-parse --git-common-dir)" ]; then
    bin/worktree-setup
fi
