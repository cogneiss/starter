#!/bin/sh
# Shared repo hook. Wire up once with: git config core.hooksPath .githooks
# (composer install does this for you)

# Skip during rebase/merge/cherry-pick so `--continue` is never slowed down.
GIT_DIR=${GIT_DIR:-$(git rev-parse --git-dir 2>/dev/null)}
[ -d "$GIT_DIR/rebase-merge" ] && exit 0
[ -d "$GIT_DIR/rebase-apply" ] && exit 0
[ -f "$GIT_DIR/MERGE_HEAD" ] && exit 0
[ -f "$GIT_DIR/CHERRY_PICK_HEAD" ] && exit 0

# --- laravel-brain: Laravel-aware route/model/event graph ---------------------
# Runs in the foreground: it finishes in well under a second and needs the app
# to boot. --no-interaction suppresses the sponsor prompt, which would
# otherwise hang a non-tty commit.
if [ -f artisan ] && [ -d vendor/laramint/laravel-brain ]; then
    echo "[laravel-brain] rescanning"
    php artisan brain:scan --no-interaction --quiet >/dev/null 2>&1 || true
fi

# --- wiki:audit: refresh the documentation worklist --------------------------
# Keeps wiki/_meta/audit.json warm so `/document` has something to read. It
# rewrites one JSON file in well under a second. Deliberately does NOT launch
# Claude Code: an LLM writing files behind a `git commit` costs money the
# committer did not agree to and lands unreviewed prose.
if [ -f artisan ]; then
    php artisan wiki:audit --quiet >/dev/null 2>&1 || true
fi
