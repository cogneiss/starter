#!/usr/bin/env sh
#
# Install dependencies when a pull or checkout changed a lock file, so the tree
# never runs against stale vendor/ or node_modules/. Called by post-merge and
# post-checkout with the old and new commit.

changed="$(git diff --name-only "$1" "$2" -- composer.lock bun.lock 2>/dev/null)"

case "$changed" in
    *composer.lock*) composer install --no-interaction ;;
esac

case "$changed" in
    *bun.lock*) bun install ;;
esac

exit 0
