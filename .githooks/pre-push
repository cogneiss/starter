#!/usr/bin/env sh
#
# The whole local gate, composer verify, run before the push leaves the machine
# so nothing has to be remembered and CI is a second opinion rather than the
# first. It covers lint, Larastan + tsc, strict PHPStan, 100% type coverage, the
# suite at 100% coverage (Xdebug must be loadable; see wiki/operations/setup.md),
# dead code, unused packages, the wiki, the audit and duplication. A
# sloppy report follows that never blocks. Mutation testing stays on demand:
# composer test:mutate.
#
# A green run on a clean tree leaves the tree hash in $GIT_DIR/verified-tree.
# A later push whose every pushed ref tip has that same tree skips the gate: an
# amended message, a rebase onto nothing new or a second remote changes no file,
# so there is nothing new to check. Any content change, a missing or unreadable
# stamp, or a red run forces the full gate. A tree that differs from the stamp
# only in todo/*.status.json counts as stamped too: those files hold no code, and
# it is what the background recheck commits (bin/recheck-todo).
#
# After a full green run the hook starts bin/recheck-todo detached for the status
# files the push touches, so they are re-decided without making the push wait. SKIP_TODO_RECHECK=1
# turns that off.

# True when tree $1 is the stamped tree, or differs from it only in status files.
is_verified() {
    [ -n "$recorded" ] || return 1
    [ "$1" = "$recorded" ] && return 0
    changed="$(git diff --name-only "$recorded" "$1" 2>/dev/null)" || return 1
    [ -n "$changed" ] || return 1
    ! printf '%s\n' "$changed" | grep -Evq '^todo/[^/]+\.status\.json$'
}

zero=0000000000000000000000000000000000000000
head_tree="$(git rev-parse 'HEAD^{tree}')"
stamp="$(git rev-parse --git-dir)/verified-tree"
recorded="$(cat "$stamp" 2>/dev/null)"

# Skip only when every pushed, non-delete ref carries the stamped tree. A push
# that only deletes refs has nothing to verify; no refs on stdin (a manual run)
# always verifies.
lines=0
stale=0
pushed_status=""
while read -r _local_ref local_sha _remote_ref remote_sha; do
    lines=1
    [ "$local_sha" = "$zero" ] && continue
    base="$remote_sha"
    [ "$base" = "$zero" ] && base="$(git merge-base "$local_sha" '@{upstream}' 2>/dev/null)"
    [ -n "$base" ] && pushed_status="$pushed_status $(git diff --name-only "$base" "$local_sha" -- 'todo/*.status.json' 2>/dev/null | tr '\n' ' ')"
    tree="$(git rev-parse --verify --quiet "$local_sha^{tree}")"
    # composer verify checks the checked-out files, so a ref whose tip holds a
    # different tree would leave unverified. Push it from its own checkout.
    if [ "$tree" != "$head_tree" ]; then
        echo "pre-push: $_local_ref is not what is checked out, so composer verify cannot check it. Check it out and push from there." >&2
        exit 1
    fi
    is_verified "$tree" || stale=1
done

if [ "$lines" -eq 1 ] && [ "$stale" -eq 0 ]; then
    echo "pre-push: nothing new to verify (tree ${recorded:-n/a} or a status-file-only change already passed composer verify), skipping."
    exit 0
fi

rm -f "$stamp"

composer verify || exit 1

if [ -z "$(git status --porcelain)" ]; then
    git rev-parse 'HEAD^{tree}' > "$stamp"
fi

vendor/bin/sloppy diff '@{upstream}' --merge-base --fail-on=never || true

if [ -z "${SKIP_TODO_RECHECK:-}" ] && [ -x bin/recheck-todo ] && [ -n "$(echo $pushed_status)" ]; then
    RECHECK_FILES="$(printf '%s\n' $pushed_status | sort -u | tr '\n' ' ')" bin/recheck-todo --detach
fi
