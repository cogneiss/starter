# Findings the dead-code detector cannot resolve because the call happens
# through reflection. Every entry carries the reason it is here. Genuine dead
# code is deleted, not baselined — do not add an entry without a comment.
parameters:
    ignoreErrors:
        # The Laravel container builds these through reflection on the
        # constructor signature, so no literal `new` appears anywhere.
        -
            message: '#^Unused App\\(Actions|Ai\\Actions|Auth\\Drivers|Policies|Rules|Support|Webhooks)\\.*::__construct$#'
            identifier: shipmonk.deadMethod
            reportUnmatched: false

        # Larastan resolves `resolve(Interface::class)` to the class the
        # container binds — the zero-key null implementation — so no call in
        # the analysed code is ever typed against the interface itself. The
        # interface methods are the seam's contract; Sentry and PostHog reach
        # them the moment a key binds the real reporter.
        -
            message: '#^Unused App\\Contracts\\(AnalyticsReporter|ErrorReporter)::.*$#'
            identifier: shipmonk.deadMethod
            reportUnmatched: false

        # spatie/laravel-data objects are built by the package (from a model, an
        # array or a request) and read by its serialisers and the TypeScript
        # transformer. Nothing reads the promoted properties from PHP by design.
        -
            message: '#^(Unused App\\(Data|Ai\\Blocks)\\.*::(__construct|fromModel)|Property App\\Data\\.*is never read)$#'
            paths:
                - app/Data/*
                - app/Ai/Blocks/*
            reportUnmatched: false

        # An agent names a trend as a string (`"trend": "up"`); the case is
        # reached by spatie/laravel-data casting that value, never by a literal
        # `AiMetricTrend::Up` in PHP. Dropping a case would drop what the model
        # is allowed to send.
        -
            message: '#^Unused App\\Enums\\AiMetricTrend::.*$#'
            identifier: shipmonk.deadEnumCase
            reportUnmatched: false

        # Eloquent boots trait hooks by naming convention (`boot<TraitName>`),
        # discovered with reflection at model boot.
        -
            message: '#^Unused App\\Concerns\\BelongsToOrganization::bootBelongsToOrganization$#'
            identifier: shipmonk.deadMethod
            reportUnmatched: false
